<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Postiz media definitions — mapped to Postiz providers -->
    <record id="social_marketing_media_postiz_linkedin" model="social_marketing.media">
        <field name="name">Postiz: LinkedIn</field>
        <field name="media_type">linkedin</field>
        <field name="media_description">LinkedIn via Postiz proxy — use Postiz API key for posting</field>
        <field name="has_streams" eval="False"/>
        <field name="can_link_accounts" eval="True"/>
        <field name="max_post_length">3000</field>
    </record>
</odoo>
