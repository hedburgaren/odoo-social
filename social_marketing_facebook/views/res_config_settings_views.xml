<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_facebook" model="ir.ui.view">
        <field name="name">res.config.settings.facebook</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="social_marketing.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='social_marketing_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="facebook_settings">
                    <div class="o_setting_left_pane">
                        <field name="facebook_app_id" invisible="1"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Facebook</span>
                        <div class="text-muted">
                            Configure Facebook integration — App ID, App Secret, and Page Access Token.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
