<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Security Groups -->
        <record id="group_social_content_creator" model="res.groups">
            <field name="name">Social: Content Creator</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_social_content_approver" model="res.groups">
            <field name="name">Social: Content Approver</field>
            <field name="implied_ids" eval="[(4, ref('group_social_content_creator'))]"/>
        </record>

        <record id="group_social_content_publisher" model="res.groups">
            <field name="name">Social: Content Publisher</field>
            <field name="implied_ids" eval="[(4, ref('group_social_content_approver'))]"/>
        </record>

    </data>
</odoo>
